---
import type { Locale } from '../lib/contenido/esquemas';
import Superficie from './Superficie.astro';
import { canon, contenido, markdownDe, rutaCasa, t } from '../lib/sitio';
import CitaCanonica from '../components/CitaCanonica.astro';
import { textoDestino } from '../lib/manifiesto';

/** Origen, autoría, versiones, procedencia y licencias. El contacto aparece solo cuando existe (T107). */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { email, issues } = contenido.sitio.contact;
// Frase destacada (copy v1.1): la de la portada del núcleo, citada con enlace a su casa (RV-13).
const portada = canon.nodos.find((n) => n.id === 'portada-04')!;
const frase = { nodo: portada, ...markdownDe(portada, locale) };
const langFrase = frase.lang === locale ? locale : 'es';
---
<Superficie id="acerca" locale={locale} extraPagina={email || issues ? [{ href: '#contacto', texto: t('acerca.contacto', locale), nivel: 2 }] : []}>
  <CitaCanonica slot="antes" nodos={[frase]} lang={langFrase} rotulo={t(langFrase === 'es' ? 'contenido.canonico' : 'contenido.traduccion', locale)} fuente={rutaCasa('portada-04', locale)} textoFuente={textoDestino('portada-04', locale)} destacada />
  {(email || issues) && (
    <section id="contacto" class="seccion" aria-labelledby="contacto-titulo">
      <h2 id="contacto-titulo">{t('acerca.contacto', locale)}</h2>
      <ul>
        {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
        {issues && <li><a href={issues} rel="noopener">{t('acerca.issues', locale)} <span aria-hidden="true">↗</span></a></li>}
      </ul>
    </section>
  )}
</Superficie>
