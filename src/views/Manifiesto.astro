---
import type { Locale } from '../lib/contenido/esquemas';
import Superficie from './Superficie.astro';
import { ruta } from '../lib/i18n/rutas';
import { contenido, t } from '../lib/sitio';

/** Manifiesto · ruta Comprender (PRD v1.1 §18.1): texto canónico, problema y rutas de lectura. */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { version, date } = contenido.sitio.core;
---
<Superficie id="manifiesto" locale={locale} archivos={['docs/method/Manifiesto_Software_Humano_IA_Nucleo_v2.1.md']}>
  <Fragment slot="antes">
    <p class="version-nucleo">{t('manifiesto.version', locale, { version, fecha: date })}</p>
    <p class="enlace-integro"><a href={ruta({ tipo: 'texto-integro' }, locale)}>{t('manifiesto.integro', locale)}</a></p>
  </Fragment>
</Superficie>
