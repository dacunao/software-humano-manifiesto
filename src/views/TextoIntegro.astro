---
import type { Locale } from '../lib/contenido/esquemas';
import Superficie from './Superficie.astro';
import NodoCanonico from '../components/NodoCanonico.astro';
import Compartir from '../components/Compartir.astro';
import EnEstaSeccion from '../components/EnEstaSeccion.astro';
import { ruta } from '../lib/i18n/rutas';
import { IDIOMAS } from '../lib/i18n/idiomas';
import { obraManifiesto } from '../lib/semantica/jsonld';
import { canon, canonicoDePrincipio, contenido, markdownDe, nodo, rutaCasa, t, URL_SITIO } from '../lib/sitio';

/**
 * Texto íntegro: el núcleo v2.1 completo como documento de consulta (FR-003 v1.1), con descarga. En español, la fuente directa; en inglés y portugués, la
 * traducción de cada nodo, identificada como tal y con referencia al original (PRD §19.4).
 * Mientras una traducción esté pendiente, ese nodo se muestra en el original con su `lang`.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const nodos = canon.nodos.map((n) => ({ n, ...markdownDe(n, locale) }));
const indice = [{ titulo: t('manifiesto.indice', locale), items: canon.secciones.map((sec) => {
  // En las secciones de principio, el nombre del principio orienta más que «PRINCIPIO N».
  const esPrincipio = /^p(0[1-9]|10)$/.test(sec.ancla);
  const md = markdownDe(esPrincipio ? canonicoDePrincipio(sec.ancla).nombre : nodo(sec.ancla), locale);
  const limpio = md.markdown.replace(/^#{1,6}\s+/, '');
  const codigo = esPrincipio ? sec.ancla.toUpperCase() : /`([A-Z0-9-]+)`/.exec(limpio)?.[1];
  return { href: `#${sec.ancla}`, texto: limpio.replace(/\s*·\s*`[^`]+`/, '').replace(/`/g, ''), codigo, lang: md.lang !== locale ? md.lang : undefined };
}) }];
const pendientes = nodos.filter((x) => x.sustituido).length;
const { version, date } = contenido.sitio.core;
// Solo la descarga del idioma seleccionado (PRD §21.7: la interfaz no mezcla idiomas).
const DESCARGAS: Record<Locale, { href: string; clave: string }> = {
  es: { href: '/descargas/nucleo-v2.1-es.md', clave: 'integro.original' },
  en: { href: '/descargas/nucleo-v2.1-en.md', clave: 'integro.traduccionEn' },
  'pt-BR': { href: '/descargas/nucleo-v2.1-pt-br.md', clave: 'integro.traduccionPt' },
};
const descarga = DESCARGAS[locale];
// Panel derecho: h3 y h4 de cada sección del núcleo; el script muestra el de la sección en pantalla.
const titulo2 = (n: (typeof canon.nodos)[number]) => markdownDe(n, locale).markdown.replace(/^#{1,6}\s+/, '').replace(/`/g, '');
const porSeccion = canon.secciones.map((sec) => ({
  ancla: sec.ancla,
  titulo: titulo2(nodo(sec.ancla)).replace(/\s*·\s*[A-Z0-9-]+$/, ''),
  items: canon.nodos.filter((n) => n.section === sec.clave && n.kind === 'encabezado' && (n.nivel === 3 || n.nivel === 4))
    .map((n) => ({ href: `#${n.id}`, texto: titulo2(n), nivel: n.nivel })),
})).filter((g) => g.items.length > 0);
const titulo = markdownDe(nodo('portada-02'), locale).markdown.replace(/^#\s+/, '');
const url = (l: Locale) => `${URL_SITIO}${ruta({ tipo: 'texto-integro' }, l)}`;
const ld = [obraManifiesto({
  sitio: contenido.sitio, nombre: titulo, url: url(locale), idioma: IDIOMAS[locale].hreflang, fecha: date,
  original: url('es'), traducciones: [url('en'), url('pt-BR')],
})];
---
<Superficie id="texto-integro" locale={locale} ld={ld} indice={indice} indiceArriba claseIndice="indice-manifiesto" archivos={['docs/method/Manifiesto_Software_Humano_IA_Nucleo_v2.1.md', 'src/content/traducciones-canon']}>
  <Fragment slot="antes">
    <p class="version-nucleo">{t('manifiesto.version', locale, { version, fecha: date })}</p>
    {locale !== 'es' && (
      <p class="aviso-traduccion" data-tipo="traduccion">
        {t('contenido.traduccion', locale)} <a href={ruta({ tipo: 'manifiesto' }, 'es')} hreflang="es" lang="es">{t('manifiesto.original', locale)}</a>
      </p>
    )}
    {pendientes > 0 && <p class="aviso-traduccion">{t('contenido.traduccionPendiente', locale)}</p>}
    <section class="descargas" aria-labelledby="descargas-titulo">
      <h2 id="descargas-titulo" class="rotulo-contenido">{t('integro.descargas', locale)}</h2>
      <p><a href={descarga.href} download hreflang={IDIOMAS[locale].hreflang}>{t(descarga.clave, locale)}</a></p>
    </section>
  </Fragment>
  <EnEstaSeccion slot="derecha" grupos={porSeccion} locale={locale} />
  <article class="manifiesto lectura" data-tipo="cita-canonica">
    {nodos.map(({ n, markdown, lang }) => (
      <>
        {lang === locale ? <NodoCanonico nodo={n} markdown={markdown} desplazamiento={1} />
        : <div lang={lang}><NodoCanonico nodo={n} markdown={markdown} desplazamiento={1} /></div>}
        {n.kind === 'encabezado' && n.nivel === 2 && (
          <Compartir locale={locale} href={rutaCasa(n.id, locale)} titulo={markdown.replace(/^#{1,6}\s+/, '').replace(/`/g, '')} />
        )}
      </>
    ))}
  </article>
</Superficie>
