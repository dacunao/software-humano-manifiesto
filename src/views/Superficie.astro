---
import type { IdSuperficie, Locale } from '../lib/contenido/esquemas';
import type { NodoLD } from '../lib/semantica/jsonld';
import Base from '../layouts/Base.astro';
import Secciones from '../components/Secciones.astro';
import type { GrupoIndice } from '../components/IndiceLateral.astro';
import { fechaActualizacion, superficie, t, texto } from '../lib/sitio';

/** Vista común de una superficie: encabezado, secciones y ranura para lo propio de cada una. */
interface Props {
  id: IdSuperficie;
  locale: Locale;
  ld?: NodoLD[];
  archivos?: string[];
  /** Grupos adicionales del índice lateral, antes o en lugar de las secciones. */
  indice?: GrupoIndice[] | undefined;
  indiceArriba?: boolean;
  claseIndice?: string | undefined;
}
const { id, locale, ld = [], archivos = [], indice, indiceArriba = false, claseIndice } = Astro.props;
const s = superficie(id);
const titulo = texto(s.title, locale);
const descripcion = texto(s.description, locale);
const actualizado = fechaActualizacion([`src/content/superficies/${id}.yaml`, ...archivos]);
const propio: GrupoIndice[] = s.sections.length > 1
  ? [{ titulo: t('indice.enEstaPagina', locale), items: s.sections.map((sec) => {
      const x = texto(sec.title, locale);
      return { href: `#${sec.id}`, texto: x.texto, lang: x.lang !== locale ? x.lang : undefined };
    }) }]
  : [];
const grupos = indice ?? propio;
const RUTAS: Partial<Record<IdSuperficie, string>> = { manifiesto: 'ruta.manifiesto', principios: 'ruta.principios', aplicacion: 'ruta.aplicacion', verificacion: 'ruta.verificacion' };
const rutaLectura = RUTAS[id];
---
<Base locale={locale} pagina={{ tipo: id }} titulo={titulo.texto} descripcion={descripcion.texto} ld={ld} actualizado={actualizado} indice={grupos} indiceArriba={indiceArriba} claseIndice={claseIndice}>
  <header class="encabezado-superficie">
    {rutaLectura && <p class="rotulo-seccion">{t('ruta.rotulo', locale)} · {t(rutaLectura, locale)}</p>}
    <h1 lang={titulo.lang !== locale ? titulo.lang : undefined}>{titulo.texto}</h1>
    <p class="entradilla" lang={descripcion.lang !== locale ? descripcion.lang : undefined}>{descripcion.texto}</p>
  </header>
  <slot name="antes" />
  <Secciones secciones={s.sections} locale={locale} superficie={id} />
  <slot />
  {Astro.slots.has('derecha') && <Fragment slot="derecha"><slot name="derecha" /></Fragment>}
</Base>
