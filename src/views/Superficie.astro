---
import type { IdSuperficie, Locale } from '../lib/contenido/esquemas';
import type { NodoLD } from '../lib/semantica/jsonld';
import Base from '../layouts/Base.astro';
import Secciones from '../components/Secciones.astro';
import type { GrupoIndice } from '../components/IndiceLateral.astro';
import { canon, fechaActualizacion, markdownDe, superficie, t, texto } from '../lib/sitio';
import { nodosDelBloque } from '../lib/casas';
import type { ItemPagina } from '../components/EnEstaPagina.astro';
import { esDivision, rutaDeDivision } from '../lib/manifiesto';

/** Vista común de una superficie: encabezado, secciones y ranura para lo propio de cada una. */
interface Props {
  id: IdSuperficie;
  locale: Locale;
  ld?: NodoLD[];
  archivos?: string[];
  /** Grupos adicionales del índice lateral, antes o en lugar de las secciones. */
  indice?: GrupoIndice[] | undefined;
  claseIndice?: string | undefined;
  /** Incluye en «En esta página» los subtítulos del texto canónico de cada sección (T202). */
  seguimiento?: boolean;
  /** Secciones que agrega la vista, para «En esta página»: tras la primera con la ranura `trasPrimera` (Mapa, R3) o al final (Contacto en Acerca de). */
  extraPagina?: ItemPagina[];
}
const { id, locale, ld = [], archivos = [], indice, claseIndice, seguimiento = false, extraPagina = [] } = Astro.props;
const s = superficie(id);
const titulo = texto(s.title, locale);
const descripcion = texto(s.description, locale);
// Con titular propio (Acerca del Manifiesto, copy v1.1), el título de la página queda como antetítulo.
const titular = s.hero ? texto(s.hero.title, locale) : undefined;
const bajada = s.hero ? texto(s.hero.text, locale) : descripcion;
const actualizado = fechaActualizacion([`src/content/superficies/${id}.yaml`, ...archivos]);
const grupos = indice;
const rutaLectura = esDivision(id) ? rutaDeDivision(id) : undefined;
const limpiar = (md: string) => md.replace(/^#{1,6}\s+/, '').replace(/`/g, '');
// «En esta página» (T202): cada sección y, con `seguimiento`, los subtítulos del texto canónico que contiene.
const enPagina: ItemPagina[] = s.sections.flatMap((sec) => {
  const x = texto(sec.title, locale);
  // Con el mismo nivel con que la página muestra cada título citado (CitaCanonica): h3 y h4.
  const propios: ItemPagina[] = seguimiento
    ? [...sec.blocks, ...sec.depth].flatMap((b) => {
        if (b.kind !== 'canon' || b.breve) return [];
        const titulos = nodosDelBloque(canon, b).filter((n) => n.kind === 'encabezado');
        const minimo = Math.min(...titulos.map((n) => n.nivel ?? 2));
        let anterior = 2;
        return titulos.flatMap((n) => {
          const visto = Math.min(6, 3 + (n.nivel ?? 2) - minimo, anterior + 1);
          anterior = visto;
          return visto <= 4 ? [{ href: `#${n.id}`, texto: limpiar(markdownDe(n, locale).markdown), nivel: visto as 3 | 4 }] : [];
        });
      })
    : [];
  return [{ href: `#${sec.id}`, texto: x.texto, nivel: 2 as const, lang: x.lang !== locale ? x.lang : undefined }, ...propios];
});
// Las secciones de la vista van tras la primera sección del contenido, en el mismo orden que en la página.
const finPrimera = enPagina.findIndex((it, i) => i > 0 && it.nivel === 2);
// Con la ranura `trasPrimera`, tras la primera sección; si no, al final, donde la vista las agrega.
if (extraPagina.length) enPagina.splice(Astro.slots.has('trasPrimera') && finPrimera >= 0 ? finPrimera : enPagina.length, 0, ...extraPagina);
---
<Base locale={locale} pagina={{ tipo: id }} titulo={titulo.texto} descripcion={descripcion.texto} ld={ld} actualizado={actualizado} indice={grupos} claseIndice={claseIndice} enPagina={enPagina}>
  <header class="encabezado-superficie">
    {rutaLectura && <p class="rotulo-seccion">{t('ruta.rotulo', locale)} · {t(rutaLectura, locale)}</p>}
    {titular && <p class="rotulo-seccion" lang={titulo.lang !== locale ? titulo.lang : undefined}>{titulo.texto}</p>}
    <h1 lang={(titular ?? titulo).lang !== locale ? (titular ?? titulo).lang : undefined}>{(titular ?? titulo).texto}</h1>
    <p class="entradilla" lang={bajada.lang !== locale ? bajada.lang : undefined}>{bajada.texto}</p>
  </header>
  <slot name="antes" />
  {Astro.slots.has('trasPrimera') ? (
    <>
      <Secciones secciones={s.sections.slice(0, 1)} locale={locale} superficie={id} />
      <slot name="trasPrimera" />
      <Secciones secciones={s.sections.slice(1)} locale={locale} superficie={id} />
    </>
  ) : <Secciones secciones={s.sections} locale={locale} superficie={id} />}
  <slot />
  {Astro.slots.has('derecha') && <Fragment slot="derecha"><slot name="derecha" /></Fragment>}
</Base>
