---
import type { Locale } from '../lib/contenido/esquemas';
import { t } from '../lib/sitio';

/**
 * Día y noche (PRD v1.4 §21.7, FR-020, RQ-17). Mejora progresiva: sin JavaScript no aparece y el
 * sitio sigue la preferencia del sistema. La elección es local, reversible y prescindible.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---
<div class="control-tema" data-control-tema hidden>
  <button type="button" data-tema-alternar aria-pressed="false">
    <svg class="icono-sol" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    <svg class="icono-luna" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
    <span class="solo-lectores">{t('tema.oscuro', locale)}</span>
  </button>
</div>
<script>
  import '../cliente/tema';
</script>
