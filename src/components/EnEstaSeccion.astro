---
import type { Locale } from '../lib/contenido/esquemas';
import { t } from '../lib/sitio';

/**
 * Panel derecho «En esta sección» (decisión del 2026-09-27): los h3 y h4 del texto canónico de
 * la sección en pantalla. El script lo muestra y marca la sección en el índice lateral; sin
 * JavaScript no aparece.
 */
export interface GrupoSeccion {
  /** id del elemento que marca el inicio de la sección en la página. */
  ancla: string;
  titulo: string;
  items: { href: string; texto: string; nivel: number | undefined }[];
}
interface Props {
  grupos: GrupoSeccion[];
  locale: Locale;
}
const { grupos, locale } = Astro.props;
---
{grupos.length > 0 && (
  <aside class="en-esta-seccion" aria-labelledby="en-esta-seccion-titulo" data-seguimiento hidden>
    <p id="en-esta-seccion-titulo" class="rotulo-contenido">{t('indice.enEstaSeccion', locale)}</p>
    {grupos.map((g) => (
      <div data-seccion={g.ancla} hidden>
        <p class="titulo-seccion">{g.titulo}</p>
        <ol>{g.items.map((i) => <li class={`nivel-${i.nivel}`}><a href={i.href}>{i.texto}</a></li>)}</ol>
      </div>
    ))}
  </aside>
)}
<script>
  import '../cliente/seguimiento';
</script>
