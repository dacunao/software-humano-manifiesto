---
import type { NodoCanonico } from '../lib/canon/lector';
import NodoCanonicoC from './NodoCanonico.astro';

interface Props {
  nodos: { nodo: NodoCanonico; markdown: string }[];
  /** Rótulo visible que distingue la cita canónica de la explicación (FR-017). */
  rotulo: string;
  /** Idioma del texto citado (es original, o el de la traducción). */
  lang: string;
  /** Enlace a la casa del pasaje; se omite cuando la cita está en su casa (PRD v1.2 §18.3). */
  fuente?: string | undefined;
  textoFuente?: string | undefined;
  /** Panel Tinta (especificación §7.5): declaraciones y citas breves. Los pasajes largos llevan borde. */
  destacada?: boolean;
  /** Nivel del primer encabezado citado según dónde queda la cita (bajo un h2, h3). */
  nivelBase?: number;
}

const { nodos, rotulo, lang, fuente, textoFuente, destacada = false, nivelBase = 3 } = Astro.props;

// Los niveles del núcleo se trasladan al contexto sin saltar ninguno al descender (PRD §21.4, WCAG 1.3.1).
const niveles = nodos.filter(({ nodo }) => nodo.kind === 'encabezado').map(({ nodo }) => nodo.nivel ?? 2);
const minimo = Math.min(...niveles);
let anterior = nivelBase - 1;
const nivelDe = new Map(nodos.filter(({ nodo }) => nodo.kind === 'encabezado').map(({ nodo }) => {
  const nivel = Math.min(6, nivelBase + (nodo.nivel ?? 2) - minimo, anterior + 1);
  anterior = nivel;
  return [nodo.id, nivel] as const;
}));
---
<figure class:list={['cita-canonica', { destacada }]} data-tipo="cita-canonica">
  <figcaption class="rotulo-contenido">{rotulo}</figcaption>
  <blockquote lang={lang} cite={fuente} class="lectura">
    {nodos.map(({ nodo, markdown }) => <NodoCanonicoC nodo={nodo} markdown={markdown} nivel={nivelDe.get(nodo.id)} />)}
  </blockquote>
  {fuente && <p class="fuente"><a href={fuente}>{textoFuente}</a></p>}
</figure>
