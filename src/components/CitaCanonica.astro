---
import type { NodoCanonico } from '../lib/canon/lector';
import NodoCanonicoC from './NodoCanonico.astro';

interface Props {
  nodos: { nodo: NodoCanonico; markdown: string }[];
  /** Rótulo visible que distingue la cita canónica de la explicación (FR-017). */
  rotulo: string;
  /** Idioma del texto citado (es original, o el de la traducción). */
  lang: string;
  /** Enlace a la casa del pasaje; se omite cuando la cita está en su casa (PRD v1.2 §18.3). */
  fuente?: string | undefined;
  textoFuente?: string | undefined;
  /** Panel Tinta (especificación §7.5): declaraciones y citas breves. Los pasajes largos llevan borde. */
  destacada?: boolean;
}

const { nodos, rotulo, lang, fuente, textoFuente, destacada = false } = Astro.props;
---
<figure class:list={['cita-canonica', { destacada }]} data-tipo="cita-canonica">
  <figcaption class="rotulo-contenido">{rotulo}</figcaption>
  <blockquote lang={lang} cite={fuente} class="lectura">
    {nodos.map(({ nodo, markdown }) => <NodoCanonicoC nodo={nodo} markdown={markdown} desplazamiento={1} />)}
  </blockquote>
  {fuente && <p class="fuente"><a href={fuente}>{textoFuente}</a></p>}
</figure>
