---
import type { Locale } from '../lib/contenido/esquemas';
import { ruta } from '../lib/i18n/rutas';
import { contenido, t } from '../lib/sitio';

/** FR-012 · versión del núcleo, fecha de actualización, procedencia y estado del preset. */
interface Props {
  locale: Locale;
  actualizado?: string | undefined;
}
const { locale, actualizado } = Astro.props;
---
<p class="procedencia">
  <a href={ruta({ tipo: 'manifiesto' }, locale)}>{t('nav.version', locale, { version: contenido.sitio.core.version })}</a>
  · <a href={ruta({ tipo: 'speckit' }, locale)}>{t('pie.estadoPreset', locale, { version: contenido.estado.version })}</a>
  {actualizado && <> · {t('pie.actualizado', locale, { fecha: actualizado })}</>}
  · <a href={`${ruta({ tipo: 'acerca' }, locale)}#procedencia`}>{t('pie.procedencia', locale)}</a>
</p>
