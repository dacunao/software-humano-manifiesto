---
import type { Bloque, IdSuperficie, Locale, SeccionSuperficie } from '../lib/contenido/esquemas';
import { canon, contenido as datos, markdownDe, rutaCasa, t, texto } from '../lib/sitio';
import { casas, nodosDelBloque } from '../lib/casas';
import BloqueEditorial from './BloqueEditorial.astro';
import CitaCanonica from './CitaCanonica.astro';
import Comparacion from './Comparacion.astro';
import ListaPrincipios from './ListaPrincipios.astro';
import EstadoAdaptacion from './EstadoAdaptacion.astro';
import Compartir from './Compartir.astro';
import { esDivision } from '../lib/manifiesto';
import { ruta } from '../lib/i18n/rutas';

/**
 * Un acto del recorrido o una sección de superficie: una idea dominante visible (PRD §21.1)
 * y la profundidad en un <details> con título explícito (P04, PRD §21.3).
 */
interface Props {
  seccion: SeccionSuperficie;
  locale: Locale;
  superficie: IdSuperficie;
}
const { seccion: sec, locale, superficie } = Astro.props;
// Dentro de su casa, el pasaje de origen está en la misma página: no se repite el enlace (P06).
const enCasa = (id?: string) => !!id && casas(canon).get(id) === superficie;
const datosSitio = datos.sitio;
const editorEnLinea = datosSitio.publisher.enLinea;
const titulo = texto(sec.title, locale);
const pregunta = sec.question ? texto(sec.question, locale) : undefined;
const cita = (b: Extract<Bloque, { kind: 'canon' }>) => {
  const ns = nodosDelBloque(canon, b);
  const nodos = ns.map((n) => ({ nodo: n, ...markdownDe(n, locale) }));
  const lang = nodos.every((x) => x.lang === locale) ? locale : 'es';
  const primero = ns.find((n) => n.kind !== 'encabezado') ?? ns[0]!;
  return {
    nodos,
    lang,
    rotulo: t(lang === 'es' ? 'contenido.canonico' : 'contenido.traduccion', locale),
    // En su casa el pasaje no remite a otra parte; fuera de ella (cita breve), a su casa (§18.3 v1.2).
    fuente: enCasa(primero.id) ? undefined : rutaCasa(primero.id, locale),
    textoFuente: t('contenido.fuente', locale),
  };
};
const grupos = [sec.blocks, sec.depth] as const;
---
<section id={sec.id} aria-labelledby={`${sec.id}-titulo`} class="seccion">
  <h2 id={`${sec.id}-titulo`} lang={titulo.lang !== locale ? titulo.lang : undefined}>{titulo.texto}</h2>
  {esDivision(superficie) && <Compartir locale={locale} href={`${ruta({ tipo: superficie }, locale)}#${sec.id}`} titulo={titulo.texto} />}
  {pregunta?.texto && <p class="pregunta" lang={pregunta.lang !== locale ? pregunta.lang : undefined}>{pregunta.texto}</p>}
  {grupos.map((lista, i) => {
    const contenido = lista.map((b) => {
      if (b.kind === 'entrada') return <BloqueEditorial entrada={b.entrada} locale={locale} sinOrigen={enCasa(b.entrada.derivedFrom)} />;
      if (b.kind === 'comparacion') return <Comparacion sistema={b.sistema} persona={b.persona} locale={locale} />;
      if (b.kind === 'principios') return <ListaPrincipios locale={locale} />;
      if (b.kind === 'estado-adaptacion') return <EstadoAdaptacion locale={locale} />;
      if (b.kind === 'editor') return editorEnLinea && <p class="enlace-agencia"><a href={datosSitio.publisher.url} rel="noopener">{t('pie.conocer', locale)} <span aria-hidden="true">↗</span></a></p>;
      const c = cita(b);
      return <CitaCanonica nodos={c.nodos} lang={c.lang} rotulo={c.rotulo} fuente={c.fuente} textoFuente={c.textoFuente} />;
    });
    if (i === 0) return contenido;
    return lista.length > 0 && (
      <details class="profundidad">
        <summary>{t('contenido.profundizar', locale)}: {titulo.texto}</summary>
        {contenido}
      </details>
    );
  })}
</section>
