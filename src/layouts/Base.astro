---
import '../styles/global.css';
import type { Locale } from '../lib/contenido/esquemas';
import { IDIOMAS } from '../lib/i18n/idiomas';
import { alternas, ruta, type Pagina } from '../lib/i18n/rutas';
import { grafo, paginaWeb, persona, sitioWeb, type NodoLD } from '../lib/semantica/jsonld';
import { contenido, hayBorrador, rutaDescarga, t, URL_SITIO } from '../lib/sitio';
import NavegacionGlobal from '../components/NavegacionGlobal.astro';
import Procedencia from '../components/Procedencia.astro';
import IndiceLateral, { type GrupoIndice } from '../components/IndiceLateral.astro';
import Busqueda from '../components/Busqueda.astro';
import ControlTema from '../components/ControlTema.astro';

interface Props {
  locale: Locale;
  pagina: Pagina;
  titulo: string;
  descripcion: string;
  /** Nodos JSON-LD propios de la página, además de WebPage. */
  ld?: NodoLD[];
  /** Pie: fecha del último cambio de la página (FR-012). */
  actualizado?: string;
  /** Índice lateral de la superficie actual (T095). */
  indice?: GrupoIndice[] | undefined;
  claseIndice?: string | undefined;
}
const { locale, pagina, titulo, descripcion, ld = [], actualizado, indice, claseIndice } = Astro.props;
const lang = IDIOMAS[locale].hreflang;
const url = `${URL_SITIO}${ruta(pagina, locale)}`;
const esInicio = pagina.tipo === 'inicio';
const tituloCompleto = esInicio ? titulo : `${titulo} · ${contenido.sitio.name}`;
const nodosLD: NodoLD[] = [
  ...(esInicio ? [sitioWeb(contenido.sitio, url, lang)] : []),
  paginaWeb(titulo, url, lang, descripcion),
  ...(pagina.tipo === '404' ? [] : ld),
];
const token = contenido.sitio.analytics.cloudflareToken;
// FR-003 v1.2: solo la descarga del idioma de la página; en traducción, el original queda a un paso.
const DESCARGA: Record<Locale, string> = { es: 'integro.original', en: 'integro.traduccionEn', 'pt-BR': 'integro.traduccionPt' };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/tema.js"></script>
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {pagina.tipo !== '404' && <link rel="canonical" href={url} />}
    {pagina.tipo !== '404' && alternas(pagina).map((a) => <link rel="alternate" hreflang={a.hreflang} href={`${URL_SITIO}${a.ruta}`} />)}
    {pagina.tipo === '404' && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={lang.replace('-', '_')} />
    <meta name="author" content={persona(contenido.sitio)['name'] as string} />
    <script type="application/ld+json" set:html={grafo(nodosLD)} />
    {token && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token })} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">{t('nav.saltar', locale)}</a>
    <header class="cabecera">
      <p class="marca"><a href={ruta({ tipo: 'inicio' }, locale)}>{contenido.sitio.name}</a></p>
      {/* En teléfonos, el menú y los idiomas se despliegan desde «Menú» (especificación §7.1: cabecera de 56 px). */}
      <details class="menu-movil" data-menu-movil>
        <summary>{t('nav.menu', locale)}</summary>
        <NavegacionGlobal locale={locale} pagina={pagina} />
      </details>
      <Busqueda locale={locale} />
      <ControlTema locale={locale} />
    </header>
    {/* Aviso (especificación §7.8): ícono y título, no solo color. */}
    {hayBorrador(locale) && (
      <p class="aviso-borrador" role="note">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3z" /><path d="M12 10v4M12 17h.01" /></svg>
        <span><strong>{t('aviso.titulo', locale)}</strong> {t('aviso.borrador', locale)}</span>
      </p>
    )}
    <div class:list={['lienzo', { 'con-indice': !!indice?.length, 'con-derecha': Astro.slots.has('derecha') }]}>
      <main id="contenido" tabindex="-1">
        <slot />
      </main>
      {indice?.length ? (
        <details class="indice-plegable" data-indice-plegable>
          <summary><span>{t('indice.contenido', locale)}</span><span class="seccion-actual" data-seccion-actual aria-hidden="true" /></summary>
          <IndiceLateral grupos={indice} etiqueta={t('indice.rotulo', locale)} clase={claseIndice} />
        </details>
      ) : null}
      <slot name="derecha" />
    </div>
    <footer class="pie">
      <slot name="pie" />
      <p class="descarga-pie">
        <a href={rutaDescarga(locale)} download hreflang={lang}>{t('integro.descargas', locale)} · {t(DESCARGA[locale], locale)}</a>
        {locale !== 'es' && <> · {t('pie.traduccion', locale)} <a href={rutaDescarga('es')} download hreflang="es" lang="es">{t('integro.original', 'es')}</a></>}
      </p>
      <Procedencia locale={locale} actualizado={actualizado} />
      <p class="preferencias-pie"><button type="button" data-tema-sistema hidden>{t('tema.sistema', locale)}</button></p>
      <p class="licencia-pie">{t('pie.licencia', locale)} <a href={`${ruta({ tipo: 'acerca' }, locale)}#licencias`}>{t('pie.licenciasDetalle', locale)}</a></p>
      {/* PRD v1.3 §18.4: el editor siempre; el enlace, solo si su sitio está en línea (sin enlaces sin destino). */}
      <p class="editor-pie">
        {t('pie.editor', locale, { editor: contenido.sitio.publisher.name })}
        {contenido.sitio.publisher.enLinea && <> · <a href={contenido.sitio.publisher.url} rel="noopener">{t('pie.conocer', locale)} <span aria-hidden="true">↗</span></a></>}
      </p>
    </footer>
    <script>import '../cliente/seguimiento';</script>
  </body>
</html>
